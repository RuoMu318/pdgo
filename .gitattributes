* text=auto
*.md text working-tree-encoding=UTF-8
*.yaml text working-tree-encoding=UTF-8
*.yml text working-tree-encoding=UTF-8
*.json text working-tree-encoding=UTF-8

# Generated PDGO activity Skills must preserve upstream workflow bodies byte-for-byte
# at the line-ending level used by the integration verifier.
skills/** text eol=lf working-tree-encoding=UTF-8

# Vendored upstream Agent prompts are retained byte-for-byte for source-SHA verification.
integrations/external-agents/agency-agents/prompts/** whitespace=-trailing-space,-blank-at-eof,-conflict-marker
